            toggleLabel?.querySelector<HTMLElement>('.project-details-idle-long')?.toggleAttribute('hidden', expanded);
            toggleLabel?.querySelector<HTMLElement>('.project-details-expanded')?.toggleAttribute('hidden', !expanded);
