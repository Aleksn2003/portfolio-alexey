        typingObserver.observe(typingLine);
        const syncTypingVisibility = () => { if (document.hidden) pauseTyping(); else scheduleTyping(); };
        document.addEventListener('visibilitychange', syncTypingVisibility);
        return () => { pauseTyping(); typingObserver.disconnect(); document.removeEventListener('visibilitychange', syncTypingVisibility); typingLine.textContent = 'Создавать.'; };
