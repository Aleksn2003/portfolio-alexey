        });
        const closeMobileProject = () => projectPanels.forEach(close => close(false));
        mobileProjectClose.addEventListener('click', closeMobileProject);
        mobileProjectDialog.addEventListener('cancel', event => { event.preventDefault(); closeMobileProject(); });
        mobileProjectDialog.addEventListener('click', event => { if (event.target === mobileProjectDialog) closeMobileProject(); });
        mobileProjects.addEventListener('change', closeMobileProject);
        document.addEventListener('pointerdown', event => { if ((event.target as Element).closest('.project-details-toggle, .project-detail-panel, .mobile-project-dialog')) return; closeMobileProject(); });
        measure(); window.addEventListener('resize', measure); frame = requestAnimationFrame(tick);
        window.addEventListener('pagehide', () => { cancelAnimationFrame(frame); railObserver.disconnect(); window.removeEventListener('scroll', pauseRailWhilePageScrolls); });
        window.addEventListener('pageshow', event => { if (event.persisted) { lastTime = 0; railObserver.observe(rail); window.addEventListener('scroll', pauseRailWhilePageScrolls, { passive: true }); frame = requestAnimationFrame(tick); } });
      }
      const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.desktop-nav a[href^="#"], .mobile-nav a[href^="#"]'));
      const trackedSections = ['about', 'projects', 'skills', 'services', 'contact'].map(id => document.getElementById(id)).filter((section): section is HTMLElement => !!section);
      const primaryNavigation = document.querySelector<HTMLElement>('.desktop-nav')!;
      const navigationHighlight = document.createElement('span');
      navigationHighlight.className = 'navigation-highlight';
      navigationHighlight.setAttribute('aria-hidden', 'true');
      primaryNavigation.prepend(navigationHighlight);
      const navigationReducedMotion = matchMedia('(prefers-reduced-motion:reduce)');
      let highlightSection: string | null = null;
      let highlightPlaced = false;
      let navigationFrame = 0;
      function updateCurrentSection() {
        navigationFrame = 0;
        const threshold = Math.min(window.innerHeight * .3, 240);
        let current = '';
        trackedSections.forEach(section => { if (section.getBoundingClientRect().top <= threshold) current = section.id; });
        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 8) current = 'contact';
        sectionLinks.forEach(link => {
          const active = link.hash === `#${current}`;
          link.classList.toggle('is-current', active);
          if (active) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
        });
        if (highlightSection !== current) {
          highlightSection = current;
          const activeLink = primaryNavigation.querySelector<HTMLElement>('a.is-current');
          gsap.killTweensOf(navigationHighlight);
          if (activeLink) {
            const navBox = primaryNavigation.getBoundingClientRect();
            const linkBox = activeLink.getBoundingClientRect();
            const destination = { x: linkBox.left - navBox.left, y: linkBox.top - navBox.top, width: linkBox.width, height: linkBox.height, opacity: 1 };
