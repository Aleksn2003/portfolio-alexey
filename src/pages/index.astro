          rail.setPointerCapture(event.pointerId); rail.classList.add('is-dragging'); event.preventDefault();
        });
        rail.addEventListener('pointermove', event => { if (dragging) { rail.scrollLeft = dragScroll - event.clientX + dragStart; offset = rail.scrollLeft; } });
        const finishDrag = () => { if (!dragging) return; dragging = false; rail.classList.remove('is-dragging'); touchedUntil = performance.now() + 1000; };
        rail.addEventListener('pointerup', finishDrag); rail.addEventListener('pointercancel', finishDrag);
        rail.addEventListener('dragstart', event => event.preventDefault());
        rail.addEventListener('touchstart', () => { touching = true; }, { passive: true });
        rail.addEventListener('touchend', () => { touching = false; touchedUntil = performance.now() + 1000; }, { passive: true });
        rail.addEventListener('touchcancel', () => { touching = false; }, { passive: true });
        rail.addEventListener('wheel', event => { if (Math.abs(event.deltaX) > Math.abs(event.deltaY) || event.shiftKey) touchedUntil = performance.now() + 1000; }, { passive: true });
        const mobileProjectDialog = document.querySelector<HTMLDialogElement>('.mobile-project-dialog')!;
        const mobileProjectContent = mobileProjectDialog.querySelector<HTMLElement>('.mobile-project-content')!;
        const mobileProjectClose = mobileProjectDialog.querySelector<HTMLButtonElement>('.mobile-project-close')!;
        let activeMobilePanel: HTMLElement | null = null;
        const mobileProjects = matchMedia('(max-width:760px)');
        const pauseRailWhilePageScrolls = () => {
          if (mobileProjects.matches) touchedUntil = performance.now() + 700;
        };
        window.addEventListener('scroll', pauseRailWhilePageScrolls, { passive: true });
        const projectPanels = new Map<HTMLElement, (expanded: boolean) => void>();
        rail.querySelectorAll<HTMLElement>('.project-card').forEach(card => {
          const toggle = card.querySelector<HTMLButtonElement>('.project-details-toggle')!;
          const panel = card.querySelector<HTMLElement>('.project-detail-panel')!;
          const setExpanded = (expanded: boolean) => {
            if (expanded) projectPanels.forEach((close, other) => { if (other !== card) close(false); });
            toggle.setAttribute('aria-expanded', String(expanded));
