      });
      menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeMenu()));
      document.addEventListener('keydown', event => { if (event.key === 'Escape' && menu && !menu.hidden) { closeMenu(); menuButton?.focus(); } });
      document.addEventListener('pointerdown', event => { if (!(event.target as Element).closest('.site-header')) closeMenu(); });
      document.querySelectorAll('.desktop-nav a[href^="#"]').forEach(link => link.addEventListener('click', () => { if (mobileHeader.matches) closeMenu(); }));
      mobileHeader.addEventListener('change', placeHeaderTools);
      placeHeaderTools();
    </script>
