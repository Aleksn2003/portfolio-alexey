            const siblings = element.classList.contains('service-card') || element.classList.contains('principle') ? Array.from(element.parentElement?.children || []) : [];
            const compactMotion = matchMedia('(max-width:760px), (pointer:coarse)').matches;
            gsap.from(element, { opacity: 0, y: compactMotion ? 8 : 22, duration: compactMotion ? .42 : .7, delay: Math.max(0, siblings.indexOf(element)) * (compactMotion ? .025 : .08), ease: 'power2.out', clearProps: 'opacity,transform' });
          });
        }, { threshold: .08, rootMargin: '0px 0px -35px 0px' });
