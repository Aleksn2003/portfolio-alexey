---
import '../styles/global.css';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait-cutout.webp';
import { profile, projects, services } from '../data/portfolio';
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path}`;
const icons: Record<string, string> = { PHP: 'php', PostgreSQL: 'postgresql', Docker: 'docker' };
const messengers = [
  { label: 'Telegram', href: profile.telegram, icon: 'telegram' },
  { label: 'WhatsApp', href: profile.whatsapp, icon: 'whatsapp' },
  { label: 'MAX', href: profile.max, icon: '' },
];
const contacts = [
  { label: 'Email', href: profile.email ? `mailto:${profile.email}` : '', value: profile.email },
  { label: 'Telegram', href: profile.telegram, value: '@AlexeyNikolaevN' },
  { label: 'WhatsApp', href: profile.whatsapp, value: '+7 999 173-65-10' },
  { label: 'MAX', href: profile.max, value: 'Написать в MAX' },
].filter(contact => contact.href);
const canonical = Astro.site ? new URL(import.meta.env.BASE_URL, Astro.site) : undefined;

---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Портфолио Алексея: веб-разработка, PHP, PostgreSQL и Docker. Проекты, навыки и контакты." />
    <meta name="theme-color" content="#f6f7f9" />
    <meta property="og:title" content="Алексей Н. — веб-разработчик" />
    <meta property="og:description" content="Изучаю fullstack и создаю полезные веб-приложения." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={asset('assets/img/favicon.svg')} />
    <title>Алексей Н. — веб-разработчик</title>
    <script is:inline>
      try {
        const preference = localStorage.getItem('portfolio-theme');
        document.documentElement.dataset.theme = preference || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <header class="site-header">
      <div class="shell flex items-center justify-between gap-4">
        <nav aria-label="Основная навигация" class="desktop-nav flex items-center gap-7">
          <a href="#about">Обо мне</a><a href="#projects">Проекты</a><a href="#skills">Навыки</a><a href="#services">Услуги</a><div class="nav-contact"><a href="#contact">Контакты <span class="nav-chevron" aria-hidden="true">⌄</span></a><div class="messenger-dropdown" aria-label="Мессенджеры">{messengers.map(messenger => <a href={messenger.href} target="_blank" rel="noopener noreferrer">{messenger.icon ? <span class={`messenger-icon messenger-${messenger.icon}`} style={`--messenger-icon:url('${asset(`assets/icons/${messenger.icon}.svg`)}')`} aria-hidden="true"></span> : <img class="messenger-max-logo" src={asset('assets/icons/max.webp')} width="17" height="17" alt="" />}{messenger.label}</a>)}</div></div>
        </nav>
        <div class="flex items-center gap-3">
          <div class="header-tools flex items-center gap-3">
          <button id="theme-toggle" class="icon-button" aria-label="Включить светлую тему" aria-pressed="false">
            <svg class="theme-icon theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
            <svg class="theme-icon theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.7 8.7 0 1 0 20.5 14.2Z"/></svg>
          </button>
          <a class="resume-link" href={asset('assets/files/resume.pdf')} download>Резюме</a>
          </div>
          <button id="menu-toggle" class="icon-button menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Открыть меню"><span class="burger-lines" aria-hidden="true"><i></i><i></i><i></i></span></button>
        </div>
      </div>
      <nav id="mobile-nav" class="shell mobile-nav" aria-label="Мобильная навигация" hidden>
        <a href="#about">Обо мне</a><a href="#projects">Проекты</a><a href="#skills">Навыки</a><a href="#services">Услуги</a><a href="#contact">Контакты</a>
      </nav>
    </header>
    <main id="main">
      <section class="shell hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>
        <figure class="portrait-card">
          <div class="portrait-image"><Image src={portrait} alt="Портрет Алексея" widths={[240, 360, 480]} sizes="160px" width={480} format="webp" quality={85} loading="eager" fetchpriority="high" /></div>
        </figure>
        <div class="hero-copy">
          <p class="eyebrow"><svg class="hero-role-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="18" height="14" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18m-11 0v2h4v-2" /></svg>{profile.role}</p>
          <h1 id="hero-title">Привет, я <span>Алексей.</span></h1>
          <p class="hero-description">От идеи — к работающему веб-приложению.</p>
          <p class="muted hero-note">Изучаю fullstack-разработку. Работаю с PHP, PostgreSQL и Docker, уделяя внимание и логике, и интерфейсу.</p>
          <div class="flex flex-wrap gap-3 hero-actions"><a class="button primary" href="#projects">Смотреть проекты</a><a class="button secondary" href="#contact">Связаться со мной</a></div>

          <div class="hero-stack flex flex-wrap gap-2" aria-label="Технологии интерфейса">{[{name: 'Tailwind CSS', icon: 'tailwindcss'}, {name: 'TypeScript', icon: 'typescript'}, {name: 'Vue', icon: 'vuejs'}, {name: 'JavaScript', icon: 'javascript'}].map(tech => <span><img class="hero-tech-icon" src={asset(`assets/icons/${tech.icon}.svg`)} alt="" width="28" height="28" />{tech.name}</span>)}</div>
        </div>
      </section>
      <div class="content-landscape">
      <div class="shell intro-strip" aria-label="Мой подход к работе">
        <div class="principle"><span class="principle-icon" aria-hidden="true">&lt;/&gt;</span><div><strong>Понятный код</strong><small>Логика, в которой легко разобраться</small></div></div>
        <div class="principle"><span class="principle-icon" aria-hidden="true">✧</span><div><strong>Внимание к деталям</strong><small>От структуры до последнего пикселя</small></div></div>
        <div class="principle"><span class="principle-icon" aria-hidden="true">＋</span><div><strong>Развитие через практику</strong><small>Каждый проект — следующий шаг</small></div></div>
      </div>
      <section id="about" class="shell section about-bento">
        <p class="eyebrow">ЗНАКОМСТВО</p>
        <div class="bento-grid">
          <article class="bento-story"><span class="bento-kicker">НЕМНОГО ОБО МНЕ</span><h2 aria-label="Не просто учить. Пробовать. Создавать.">Не просто учить.<br /><span class="story-type-line" aria-hidden="true">Создавать.</span></h2><p>Я Алексей. Осваиваю веб-разработку и развиваюсь в fullstack-направлении. Мне интересно разбираться в приложении целиком — от первого экрана до запросов к базе.</p><a href={asset('assets/files/resume.pdf')} class="text-link" download>Скачать резюме</a><span class="bento-decoration" aria-hidden="true">{'{ }'}</span></article>
          <article class="bento-learning"><span class="bento-kicker">В ФОКУСЕ СЕЙЧАС</span><h3>От кода<br />к системе</h3><p class="muted">PHP, PostgreSQL и Docker. Связываю интерфейс, серверную логику и данные в своих проектах.</p><div class="learning-icons" aria-label="PHP, PostgreSQL, Docker">{['PHP', 'PostgreSQL', 'Docker'].map(name => <img src={asset(`assets/icons/${icons[name]}.svg`)} width="28" height="28" alt="" />)}</div></article>
          <article class="bento-approach"><span class="bento-kicker">МОЙ ПОДХОД</span><h3>Сначала понять.<br />Потом усложнять.</h3><p class="muted">Предпочитаю понятные решения. Учусь на практике, разбираю результат и постепенно беру задачи сложнее.</p><div class="approach-flow" aria-hidden="true"><span>Идея</span><i></i><span>Код</span><i></i><span>Результат</span></div></article>
        </div>
      </section>
      <div class="story-thread" aria-hidden="true"><svg viewBox="0 0 1100 130" fill="none" preserveAspectRatio="none"><path d="M85 0 C85 38 180 46 305 46 C450 46 510 106 650 106 C805 106 890 92 1010 130" /></svg></div>
      <section id="projects" class="section section-tinted">
        <div class="shell">
          <div class="section-heading projects-heading"><p class="eyebrow">ПРАКТИКА</p><h2>Меньше слов.<br /><span>Больше практики.</span></h2><p class="muted">Проекты, через которые я учусь разработке.</p></div>
          <div class="project-rail-frame"><div class="projects-grid project-rail" aria-label="Лента проектов">{projects.map(project => <article class="project-card">
            <div class="project-visual">{project.preview && <div class="preview-browser"><Image src={project.preview} alt={`Превью сайта: ${project.title}`} widths={[640, 960]} sizes="(max-width: 760px) 90vw, 480px" width={960} format="webp" loading="lazy" /></div>}</div>
            <div class="project-body"><p class="eyebrow">{project.category} <span class="project-status">{project.status || 'Проект'}</span></p><h3>{project.title}</h3><p class="muted">{project.description}</p><div class="flex flex-wrap gap-2 project-stack">{project.stack.map(tech => <span>{tech}</span>)}</div><button type="button" class="project-details-toggle" aria-expanded="false"><span class="project-details-label"><span class="project-details-idle-short">О проекте</span><span class="project-details-idle-long">Подробнее о проекте</span><span class="project-details-expanded" hidden>Скрыть описание</span></span><span class="project-details-icon" aria-hidden="true">+</span></button><div class="project-detail-panel" hidden tabindex="0" role="region" aria-label={`О проекте: ${project.title}`}><h3>{project.title}</h3><div class="project-case"><div><small>ЗАДАЧА</small><p>{project.task}</p></div><div><small>МОЙ ВКЛАД</small><p>{project.contribution}</p></div><div class="case-result"><small>РЕЗУЛЬТАТ</small><p>{project.result}</p></div></div><p class="muted">{project.details}</p></div>{project.link && <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-link project-live-link">Открыть сайт <span aria-hidden="true">↗</span></a>}</div>
          </article>)}</div></div>
        </div>
      </section>
      <section id="skills" class="shell section">
        <div class="section-heading"><div><p class="eyebrow">ИНСТРУМЕНТЫ</p><h2>Что изучаю и применяю</h2></div><p class="muted">Развиваюсь в fullstack-направлении. Эти инструменты осваиваю на учебных проектах.</p></div>
        <div class="floating-stack" aria-label="Основные технологии, которые изучаю и применяю">
          <span class="floating-stack-word" aria-hidden="true"><span>stack</span><small>изучаю · применяю</small></span>
          {[
            {name: 'PHP', svg: 'php'},
            {name: 'PostgreSQL', svg: 'postgresql'},
            {name: 'Vue', svg: 'vuejs'},
            {name: 'JavaScript', svg: 'javascript'},
            {name: 'Tailwind CSS', svg: 'tailwindcss'},
            {name: 'Docker', svg: 'docker'},
            {name: 'Nginx', svg: 'nginx'},
            {name: 'HTML', svg: 'html5', secondary: true},
            {name: 'CSS', svg: 'css3', secondary: true},
            {name: 'TypeScript', svg: 'typescript', secondary: true},
            {name: 'GSAP', icon: '', secondary: true},
            {name: 'Astro', svg: 'astro', secondary: true},
          ].map((tech, index) => <article class={`floating-tech tech-${index} ${tech.secondary ? 'floating-secondary' : ''}`} style={`--tool-x:${50 + 40 * Math.cos((index * 360 / 12 - 90) * Math.PI / 180)}%;--tool-y:${50 + 40 * Math.sin((index * 360 / 12 - 90) * Math.PI / 180)}%;--tool-phase:${index * -.47}s;`}>
            {tech.svg ? <span class="stack-svg-icon" aria-hidden="true"><img src={asset(`assets/icons/${tech.svg}.svg`)} width="54" height="54" alt="" /></span> : <span class="gsap-mark" aria-hidden="true">gsap</span>}
            <h3>{tech.name}</h3>
          </article>)}
        </div>
      </section>
      <section id="services" class="shell section services-section">
        <div class="services-heading"><p class="eyebrow">СОТРУДНИЧЕСТВО</p><h2>Что можем<br /><span>сделать вместе.</span></h2><p class="muted">Есть идея, готовый код или задача?<br />Начнём с того, что нужно именно вам.</p></div>
        <div class="service-cards">{services.map(service => <article class="service-card"><div class="service-card-top"><span class="service-number">{service.number}</span><span class="service-symbol" aria-hidden="true">{service.number === '01' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m8 8-4 4 4 4m8-8 4 4-4 4m-3-10-2 12" /></svg> : service.number === '02' ? <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 0 1-.5-8A5.5 5.5 0 0 1 17 8a4 4 0 1 1 .5 8H16" /><path d="M12 21V12m-3 3 3-3 3 3" /></svg> : <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a5 5 0 0 0-6.4 6.4L3 18l3 3 5.3-5.3a5 5 0 0 0 6.4-6.4L14 13l-3-3 3.7-3.7Z" /></svg>}</span></div><h3>{service.title}</h3><p class="muted">{service.description}</p><div class="service-examples">{service.examples.map(example => <span>{example}</span>)}</div><div class="service-outcome"><small>НА ВЫХОДЕ</small><p>{service.outcome}</p></div><div class="service-card-bottom"><span class="service-price">{service.price}</span><a href="#contact" aria-label={`Обсудить: ${service.title}`} class="service-discuss">Обсудить задачу<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11a8 8 0 0 1-8 8H8l-5 3 1.5-6A8 8 0 1 1 21 11Z"/></svg></a></div></article>)}</div>
        <p class="services-note muted">Точный объём, сроки и стоимость обсудим до начала работы.</p>
      </section>
      <section id="contact" class="shell section">
        <div class="contact-card">
          <div class="contact-orbit" aria-hidden="true"></div>
          <div class="contact-copy"><p class="eyebrow">КОНТАКТЫ</p><h2>Есть идея?<br /><span>Давайте обсудим.</span></h2><p class="muted">Расскажите о задаче и о том, что хочется получить.</p><div class="contact-links">{contacts.map(contact => <a href={contact.href} target={contact.label !== 'Email' ? '_blank' : undefined} rel={contact.label !== 'Email' ? 'noopener noreferrer' : undefined}><small class="contact-label">{contact.label === 'Telegram' || contact.label === 'WhatsApp' ? <span class={`messenger-icon messenger-${contact.label.toLowerCase()}`} style={`--messenger-icon:url('${asset(`assets/icons/${contact.label.toLowerCase()}.svg`)}')`} aria-hidden="true"></span> : contact.label === 'MAX' ? <img class="messenger-max-logo" src={asset('assets/icons/max.webp')} width="17" height="17" alt="" /> : null}{contact.label}</small><span>{contact.value}</span></a>)}</div><a class="text-link" href={asset('assets/files/resume.pdf')} download>Скачать резюме</a></div>
          <form id="contact-form" class="contact-form" data-recipient={profile.email}>
            <label for="contact-name">Как вас зовут<input id="contact-name" name="name" autocomplete="name" placeholder="Ваше имя" required maxlength="100" /></label>
            <label for="contact-email">Ваш Email<input id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required /></label>
            <label for="contact-message">О чём поговорим?<textarea id="contact-message" name="message" rows="4" placeholder="Пара слов о вашей идее…" required maxlength="5000"></textarea></label>
            <button class="button primary" type="submit">Открыть письмо</button><p class="form-note">Откроется почтовое приложение с готовым текстом. Письмо отправляете вы.</p>
          </form>
        </div>
      </section>
      </div>
    </main>
    <footer class="shell site-footer flex flex-wrap items-center justify-between gap-4"><span>© {new Date().getFullYear()} {profile.fullName}</span><span>Создано с вниманием к деталям</span><a class="footer-github" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub — Aleksn2003"><span aria-hidden="true" style={`--github-icon:url('${asset('assets/icons/github.svg')}')`}></span>GitHub</a></footer>
    <a href="#main" class="back-to-top" aria-label="Вернуться наверх" aria-hidden="true" tabindex="-1"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 12 6-6 6 6M12 6v13"/></svg></a>
    <dialog class="mobile-project-dialog" aria-label="Описание проекта">
      <button type="button" class="mobile-project-close">Закрыть <span aria-hidden="true">×</span></button>
      <div class="mobile-project-content"></div>
    </dialog>
    <script>
      import { gsap } from 'gsap';
      const hero = document.querySelector<HTMLElement>('.hero');
      const topButton = document.querySelector<HTMLAnchorElement>('.back-to-top');
      if (hero && topButton) {
        const updateTopButton = () => {
          const visible = hero.getBoundingClientRect().bottom <= 80;
          topButton.classList.toggle('is-visible', visible);
          topButton.setAttribute('aria-hidden', String(!visible));
          topButton.tabIndex = visible ? 0 : -1;
        };
        const heroObserver = new IntersectionObserver(updateTopButton, { threshold: [0, 0.1], rootMargin: '-80px 0px 0px 0px' });
        heroObserver.observe(hero);
        updateTopButton();
      }
      const motion = gsap.matchMedia();
      if (hero) {
        motion.add('(prefers-reduced-motion: no-preference)', () => {
          gsap.timeline({ defaults: { ease: 'power3.out' } })
            .from('.portrait-card', { opacity: 0, y: 16, scale: 0.92, duration: 0.7 })
            .from('.hero-copy > .eyebrow', { opacity: 0, y: 12, duration: 0.5 }, '-=0.35')
            .from('.hero-copy h1', { opacity: 0, y: 24, duration: 0.75 }, '-=0.3')
            .from('.hero-description, .hero-note', { opacity: 0, y: 16, stagger: 0.09, duration: 0.6 }, '-=0.4')
            .from('.hero-actions', { opacity: 0, y: 12, duration: 0.5 }, '-=0.3')
            .from('.hero-stack > span', { opacity: 0, y: 10, stagger: 0.06, duration: 0.4 }, '-=0.25');
          gsap.from('.hero-grid', { opacity: 0, scale: 1.04, duration: 1.5, ease: 'power2.out' });
        }, hero);
        motion.add('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
          const glow = hero.querySelector<HTMLElement>('.hero-glow');
          if (!glow) return;
          const moveX = gsap.quickTo(glow, 'x', { duration: 0.9, ease: 'power3.out' });
          const moveY = gsap.quickTo(glow, 'y', { duration: 0.9, ease: 'power3.out' });
          const followPointer = (event: PointerEvent) => {
            if (event.pointerType !== 'mouse') return;
            const bounds = hero.getBoundingClientRect();
            if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
              resetGlow();
              return;
            }
            moveX(event.clientX - bounds.left - bounds.width * 0.5);
            moveY(event.clientY - bounds.top - bounds.height * 0.3);
          };
          const resetGlow = () => { moveX(0); moveY(0); };
          window.addEventListener('pointermove', followPointer, { passive: true });
          document.documentElement.addEventListener('pointerleave', resetGlow);
          window.addEventListener('blur', resetGlow);
          return () => {
            window.removeEventListener('pointermove', followPointer);
            document.documentElement.removeEventListener('pointerleave', resetGlow);
            window.removeEventListener('blur', resetGlow);
          };
        }, hero);
      }
      const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
      contactForm?.addEventListener('submit', event => {
        event.preventDefault();
        if (!contactForm.reportValidity() || !contactForm.dataset.recipient) return;
        const data = new FormData(contactForm);
        const body = `Здравствуйте, Алексей!\n\n${data.get('message')}\n\n${data.get('name')}\nEmail: ${data.get('email')}`;
        window.location.href = `mailto:${contactForm.dataset.recipient}?subject=${encodeURIComponent('Обсуждение проекта — портфолио')}&body=${encodeURIComponent(body)}`;
      });
      const rail = document.querySelector<HTMLElement>('.project-rail');
      if (rail) {
        const originals = Array.from(rail.querySelectorAll<HTMLElement>('.project-card'));
        const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
        let touchedUntil = 0;
        let lastTime = 0;
        let frame = 0;
        let offset = 0;
        let loopWidth = 0;
        let railVisible = false;
        const railObserver = new IntersectionObserver(entries => { railVisible = entries[0].isIntersecting; }, { threshold: 0 });
        railObserver.observe(rail);
        const measure = () => { loopWidth = originals.reduce((sum, card) => sum + card.getBoundingClientRect().width + 24, 0); };
        originals.forEach(card => {
          const clone = card.cloneNode(true) as HTMLElement;
          clone.classList.add('rail-copy');
          rail.appendChild(clone);
        });
        const tick = (time: number) => {
          const elapsed = lastTime ? Math.min(time - lastTime, 50) : 0;
          lastTime = time;
          const paused = !railVisible || dragging || touching || reducedMotion.matches || rail.querySelector('.project-details-toggle[aria-expanded="true"]') || time < touchedUntil || document.hidden;
          if (!paused && loopWidth > 0) {
            offset = (offset + elapsed * 0.018) % loopWidth;
            rail.scrollLeft = offset;
          } else { offset = rail.scrollLeft; }
          frame = requestAnimationFrame(tick);
        };
        let dragging = false;
        let touching = false;
        let dragStart = 0;
        let dragScroll = 0;
        rail.addEventListener('pointerdown', event => {
          touchedUntil = performance.now() + 1000;
          if (event.pointerType !== 'mouse' || event.button !== 0 || (event.target as Element).closest('a, button, .project-detail-panel')) return;
