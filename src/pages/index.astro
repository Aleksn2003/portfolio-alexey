        const stack = document.querySelector<HTMLElement>('.floating-stack');
        const stackObserver = new IntersectionObserver(entries => {
          if (!entries.some(entry => entry.isIntersecting) || !stack) return;
          stackObserver.disconnect();
          gsap.from(stack.querySelectorAll('.floating-tech'), { opacity: 0, duration: .7, stagger: .045, ease: 'power2.out', clearProps: 'opacity' });
