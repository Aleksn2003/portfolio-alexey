              } else gsap.set(panel, { clearProps: 'opacity,transform' });
            } else if (!panel.hidden) {
              const finishClose = () => {
                panel.hidden = true;
                gsap.set(panel, { clearProps: 'opacity,transform' });
                if (panel.parentElement === mobileProjectContent) {
                  toggle.after(panel);
                  if (activeMobilePanel === panel) {
                    activeMobilePanel = null;
                    mobileProjectDialog.close();
                    toggle.focus({ preventScroll: true });
                  }
                }
              };
              if (reducedMotion.matches) finishClose();
              else gsap.to(panel, { opacity: 0, scaleX: activeMobilePanel === panel ? .96 : .04, scaleY: activeMobilePanel === panel ? .96 : .04, duration: .25, ease: 'power2.in', onComplete: finishClose });
            }
