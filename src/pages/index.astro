            panel.inert = !expanded;
            touchedUntil = performance.now() + 400;
            if (expanded) {
              const wasHidden = panel.hidden;
              panel.hidden = false;
              const onMobile = mobileProjects.matches;
              if (onMobile) {
                mobileProjectContent.append(panel);
                activeMobilePanel = panel;
                if (!mobileProjectDialog.open) mobileProjectDialog.showModal();
                mobileProjectClose.focus();
              }
              const overflow = onMobile ? 0 : panel.getBoundingClientRect().right - rail.getBoundingClientRect().right + 24;
              if (overflow > 0) { rail.scrollLeft += overflow; offset = rail.scrollLeft; }
              if (!reducedMotion.matches) {
                const originY = Math.max(0, Math.min(panel.offsetHeight, toggle.getBoundingClientRect().top + toggle.offsetHeight / 2 - panel.getBoundingClientRect().top));
                gsap.set(panel, { transformOrigin: onMobile ? '50% 100%' : `-12px ${originY}px` });
                if (wasHidden) gsap.set(panel, { opacity: 0, scaleX: onMobile ? .96 : .04, scaleY: onMobile ? .96 : .04 });
