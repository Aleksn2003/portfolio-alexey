      window.addEventListener('scroll', scheduleNavigationUpdate, { passive: true });
      window.addEventListener('resize', () => { highlightSection = null; scheduleNavigationUpdate(); });
      document.fonts.ready.then(() => { highlightSection = null; scheduleNavigationUpdate(); });
      updateCurrentSection();
      motion.add('(prefers-reduced-motion: no-preference)', () => {
        const targets = Array.from(document.querySelectorAll<HTMLElement>('.principle, #about > .eyebrow, .bento-grid article, .projects-heading, .project-rail-frame, #skills > .section-heading, .services-heading, .service-card, .contact-copy, .contact-form'));
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            observer.unobserve(entry.target);
