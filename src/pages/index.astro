        let wordIndex = 0, letterCount = 0, deleting = false, visible = false;
        let typingTimer: ReturnType<typeof setTimeout> | undefined;
        let nextDelay = 85;
        function pauseTyping() { clearTimeout(typingTimer); typingTimer = undefined; }
        function scheduleTyping() {
          if (!visible || document.hidden || typingTimer !== undefined) return;
          typingTimer = setTimeout(typeLetter, nextDelay);
        }
        function typeLetter() {
          typingTimer = undefined;
          if (!visible || document.hidden || !typingLine) return;
          const word = words[wordIndex];
          letterCount += deleting ? -1 : 1;
          typingLine.textContent = word.slice(0, letterCount);
          nextDelay = deleting ? 45 : 85;
          if (!deleting && letterCount === word.length) { deleting = true; nextDelay = 2200; }
          else if (deleting && letterCount === 0) { deleting = false; wordIndex = (wordIndex + 1) % words.length; nextDelay = 350; }
          scheduleTyping();
        }
        const typingObserver = new IntersectionObserver(entries => {
          visible = entries[0].isIntersecting;
          if (visible) scheduleTyping(); else pauseTyping();
